rules_version = '2';
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
// Replace the email below if your admin email is different (keep it lowercase).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }

    function isOwner() {
      return signedIn() && request.auth.token.email.lower() == 'mrugraj321@gmail.com';
    }

    function isAdmin() {
      return isOwner() || (signedIn() && exists(myDoc()) && get(myDoc()).data.role == 'admin'
        && get(myDoc()).data.status == 'approved');
    }

    function approved() {
      return isAdmin() || (signedIn() && exists(myDoc()) && get(myDoc()).data.status == 'approved');
    }

    // staff (workers) only see their tasks: no bills, no photos except task voice notes
    function isStaff() {
      return !isAdmin() && signedIn() && exists(myDoc()) && get(myDoc()).data.role == 'staff';
    }
    function family() { return approved() && !isStaff(); }

    // ----- people who use the app -----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || family());
      // New sign-ups can only create themselves as "pending member"
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == 'pending'
            && request.resource.data.role == 'member');
      // Admin can approve/remove; users can only edit their own name
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ----- bills -----
    match /entries/{id} {
      allow read: if family();
      allow create: if family() && request.resource.data.createdBy == request.auth.uid;
      allow update: if family() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if family() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // ----- daily home tasks -----
    match /tasks/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.createdBy == request.auth.uid;
      // only admins can mark a task approved (done)
      allow update: if approved() && request.resource.data.createdBy == resource.data.createdBy
        && (request.resource.data.get('status', '') != 'done' || resource.data.get('status', '') == 'done' || isAdmin());
      allow delete: if approved() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // ----- shared settings (pressing rate) -----
    match /settings/{id} {
      allow read: if family();
      allow write: if isAdmin();
    }

    // ----- who is at home (only at-home yes/no + time, written by each person for themselves) -----
    match /presence/{uid} {
      allow read: if family();
      allow write: if approved() && request.auth.uid == uid;
    }

    // photos, voice notes and videos. Staff can only hear task voice notes (tv_, tdv_)
    // and send their done photo / voice reply (tproof_, tpv_); they can't open any photo.
    match /photos/{id} {
      allow read: if family() || (approved() && (id.matches('tv_.*') || id.matches('tdv_.*')));
      allow write: if family() || (approved() && (id.matches('tproof_.*') || id.matches('tpv_.*')));
    }
  }
}
